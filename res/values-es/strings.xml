    <!-- Play policy: prominent disclosure before the accessibility service is switched on -->
    <string name="navbar_disclosure_title">Sobre los botones grandes</string>
    <string name="navbar_disclosure_msg">FamilyGrid usa el servicio de Accesibilidad de Android solo para dibujar los botones grandes de Atrás, Inicio y Apps, y para ir Atrás o al Inicio cuando los tocas.\n\nNo lee lo que hay en tu pantalla. No se recopila, guarda ni comparte nada.\n\nEn la siguiente pantalla, busca \"FamilyGrid big buttons\" y actívalo.</string>
    <string name="agree_continue">Aceptar y continuar</string>
    <string name="no_thanks">No, gracias</string>

    <!-- quiet mode -->
    <string name="quiet_label">Modo silencio de FamilyGrid</string>
    <string name="section_quiet">Modo silencio</string>
    <string name="quiet_help">Oculta las notificaciones de las apps que no están en la pantalla de inicio, para que paren los anuncios y avisos basura. Las llamadas, mensajes, alarmas y las apps de los mosaicos siguen llegando.</string>
    <string name="quiet_switch">Ocultar notificaciones basura</string>
    <string name="quiet_allow_more">Permitir también otras apps…</string>
    <string name="quiet_allow_title">Apps que pueden notificar</string>
    <string name="check_quiet">Acceso a notificaciones (modo silencio)</string>
    <string name="quiet_disclosure_title">Sobre el modo silencio</string>
    <string name="quiet_disclosure_msg">Para ocultar notificaciones basura, FamilyGrid necesita acceso a las notificaciones. Solo mira qué app envió cada notificación y la oculta si esa app no está permitida.\n\nEl texto de las notificaciones nunca se lee, guarda ni comparte.\n\nEn la siguiente pantalla, busca \"FamilyGrid quiet mode\" y actívalo.</string>

    <!-- short guides shown before sending people to Android settings -->
    <string name="guide_title">Qué hacer ahora</string>
    <string name="guide_home">En la siguiente pantalla, elige \"FamilyGrid Launcher\" como app de inicio.\n\nSi Android pregunta, toca \"Siempre\".</string>
    <string name="guide_call">Android preguntará si FamilyGrid puede hacer llamadas. Toca \"Permitir\".\n\nSi se abren los ajustes de la app, toca Permisos › Teléfono › Permitir.</string>
    <string name="guide_bt">Android preguntará por \"Dispositivos cercanos\". Toca \"Permitir\".\n\nSi se abren los ajustes de la app, toca Permisos › Dispositivos cercanos › Permitir.</string>
    <string name="continue_btn">Continuar</string>

    <!-- handover safety: USB debugging -->
    <string name="check_adb">Depuración USB desactivada</string>
    <string name="tag_recommended">Recomendado</string>
    <string name="guide_adb">La depuración USB permite que un ordenador conectado controle este teléfono. Desactívala al terminar la configuración.\n\nEn la siguiente pantalla:\n1. Toca \"Revocar autorizaciones de depuración USB\" › Aceptar\n2. Desactiva \"Depuración USB\"\n3. Desactiva \"Opciones para desarrolladores\" arriba</string>
