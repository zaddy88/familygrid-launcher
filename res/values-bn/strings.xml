    <!-- Play policy: prominent disclosure before the accessibility service is switched on -->
    <string name="navbar_disclosure_title">বড় বোতাম সম্পর্কে</string>
    <string name="navbar_disclosure_msg">FamilyGrid, Android-এর Accessibility সেবা শুধু বড় পেছনে, হোম ও অ্যাপ বোতাম দেখাতে এবং সেগুলো চাপলে পেছনে বা হোমে যেতে ব্যবহার করে।\n\nএটি আপনার স্ক্রিনের কিছুই পড়ে না। কোনো তথ্য সংগ্রহ, সংরক্ষণ বা শেয়ার করা হয় না।\n\nপরের স্ক্রিনে \"FamilyGrid big buttons\" খুঁজে চালু করুন।</string>
    <string name="agree_continue">রাজি, এগিয়ে যান</string>
