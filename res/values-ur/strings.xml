    <!-- Play policy: prominent disclosure before the accessibility service is switched on -->
    <string name="navbar_disclosure_title">بڑے بٹنوں کے بارے میں</string>
    <string name="navbar_disclosure_msg">فیملی گرڈ اینڈرائیڈ کی ایکسیسبلٹی سروس صرف بڑے واپس، ہوم اور ایپس بٹن دکھانے، اور ان کو دبانے پر واپس یا ہوم جانے کے لیے استعمال کرتا ہے۔\n\nیہ آپ کی اسکرین پر موجود کچھ نہیں پڑھتا۔ کوئی معلومات جمع، محفوظ یا شیئر نہیں کی جاتی۔\n\nاگلی اسکرین پر \"FamilyGrid big buttons\" ڈھونڈیں اور آن کریں۔</string>
    <string name="agree_continue">متفق ہوں اور آگے بڑھیں</string>
